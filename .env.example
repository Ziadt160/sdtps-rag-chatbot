# Copy to .env and adjust. No secrets are required for the local stack.

# --- Models ---
EMBED_MODEL=BAAI/bge-m3
# Pick an Arabic-capable instruct model you have pulled in Ollama, e.g.:
#   ollama pull qwen2.5:7b   (recommended)
#   ollama pull aya-expanse:8b
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.2

# Force CPU/GPU for embeddings (auto-detects CUDA if unset): cpu | cuda
# EMBED_DEVICE=cuda

# --- Evaluation ---
# RAGAS judge model (eval only; chatbot stays local). Defaults to OLLAMA_MODEL.
# A 7B local judge is slow/weak for RAGAS — point this at a stronger model for
# reliable answer-quality scores, e.g. gpt-oss:120b-cloud or glm-4.6:cloud.
# RAGAS_JUDGE_MODEL=gpt-oss:120b-cloud

# --- Retrieval tuning ---
RAG_TOP_K=5
RAG_RRF_K=60
RAG_DENSE_WEIGHT=1.0
RAG_SPARSE_WEIGHT=1.0
RAG_SERVICE_MATCH_THRESHOLD=82

# --- Semantic answer cache ---
CACHE_ENABLED=1
CACHE_MAX_SIZE=256
# cosine similarity required for a cache hit (high = only near-identical queries)
CACHE_SIM_THRESHOLD=0.97
CACHE_TTL=0            # seconds; 0 = no expiry

# --- Docker only ---
# Auto-pull OLLAMA_MODEL into the Ollama container on first start
OLLAMA_AUTO_PULL=1
